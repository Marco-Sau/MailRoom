            "hours": "={{ (() => { try { const h = parseInt((($('Webhook').first().json || {}).body || {}).hours, 10); return h >= 1 && h <= 168 ? String(h) : ''; } catch (e) { return ''; } })() }}",
            "run": "true"
          }
        },
        "options": {
          "waitForSubWorkflow": true
